<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootGrid"
    Background="{ThemeResource ControlFillColorTransparentBrush}"
    RenderTransformOrigin="0.5,0.5">
    <Grid.Resources>
        <x:Double x:Key="PressedScale">0.985</x:Double>
        <x:Double x:Key="GrabbedScale">0.90</x:Double>
    </Grid.Resources>
    <Grid.RenderTransform>
        <CompositeTransform x:Name="ItemTransform" />
    </Grid.RenderTransform>

    <!-- 与系统 Alt+Tab 一致：整张卡片只有一层半透明底和 1px 描边，标题行与缩略图区不再单独铺底 -->
    <Border
        x:Name="MainCard"
        Background="{ThemeResource CardBackgroundFillColorOnThinAcrylicBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="ItemLayoutGrid">
            <!-- 标题行固定 40 DIP（与系统 Alt+Tab 一致），LayoutEngine 按当前 DPI 换算成像素 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="TitleBorder"
                Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="11,11,0,0">
                <Grid x:Name="TitleGrid" Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center">
                        <Image
                            x:Name="AppIcon"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="DefaultIcon"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="&#xE700;"
                            Visibility="Visible" />
                    </Grid>

                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        Margin="4,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        x:Name="CloseButton"
                        Grid.Column="2"
                        Width="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Content="&#xE106;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource ControlFillColorTransparent}" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource ButtonTextColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CloseButtonHoverBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CloseButtonHoverTextColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CloseButtonHoverBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CloseButtonHoverTextColor}" />
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border
                x:Name="ContentFrame"
                Grid.Row="1"
                Margin="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,11,11">
                <Grid>
                    <TextBlock
                        x:Name="ThumbnailPlaceholderText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource ThumbnailPlaceholderTextBrush}"/>
                </Grid>
            </Border>

            <Border
                x:Name="PressOverlay"
                Grid.RowSpan="2"
                Background="{ThemeResource CardPressedOverlayBrush}"
                CornerRadius="11"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</Grid>
