<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- 整窗透明，背景由 DWM 的 Mica 背板提供；任何不透明填充都会把材质盖掉。 -->

    <Grid.Resources>
        <ResourceDictionary>
            <x:Double x:Key="TitleBarHeight">40</x:Double>

            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionButtonRoot" Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionButtonRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptionButtonRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseCaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseButtonRoot" Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseButtonRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CloseButtonHoverBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseButtonGlyph" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CloseButtonHoverTextBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseButtonRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CloseButtonPressedBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseButtonGlyph" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CloseButtonHoverTextBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="CloseButtonGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="4,16,0,6" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="14,11,12,11" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="CardGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 沉浸式标题栏：客户区已扩展到窗口顶边，这一行就是原本的系统 caption。 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Width="16"
            Height="16"
            Margin="13,0,10,0"
            VerticalAlignment="Center">
            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Ellipse
                Width="2.6"
                Height="2.6"
                Margin="0,0,5.6,4.4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="White" />
            <Ellipse
                Width="2.6"
                Height="2.6"
                Margin="0,0,0,5.6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="White" />
            <Ellipse
                Width="2.6"
                Height="2.6"
                Margin="5.6,0,0,4.4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="White" />
            <Path
                Data="M 4.6 9.6 C 6 11.6 10 11.6 11.4 9.6"
                Stroke="White"
                StrokeThickness="1.2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />
        </Grid>

        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Text="Touch-Rev 控制中心" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button
                x:Name="MinimizeButton"
                Content="&#xE921;"
                Style="{StaticResource CaptionButtonStyle}" />
            <Button
                x:Name="CloseButton"
                Content="&#xE8BB;"
                Style="{StaticResource CloseCaptionButtonStyle}" />
        </StackPanel>
    </Grid>

    <ScrollViewer
        Grid.Row="1"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20">

            <!-- 运行状态 -->
            <Border
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="14,11,14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="StatusIndicatorDot"
                        Grid.Column="0"
                        Width="8"
                        Height="8"
                        Margin="2,0,12,0"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="HookStatusText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="运行状态：未知"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 手势 -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="手势" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="拦截系统默认手势" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="向 explorer 注入拦截模块，屏蔽 Windows 自带的三/四指手势" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HookToggle" Grid.Column="2" IsOn="False" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE815;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="自定义手势识别" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="启用三指双击与三指长按移动的应用流转手势" />
                    </StackPanel>
                    <ToggleSwitch x:Name="GestureToggle" Grid.Column="2" IsOn="True" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8A7;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="任务切换卡片窗口" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="触发手势时弹出卡片式任务切换界面" />
                    </StackPanel>
                    <ToggleSwitch x:Name="WindowToggle" Grid.Column="2" IsOn="True" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <!-- 应用 -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="应用" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="开机自动启动" />
                        <TextBlock
                            x:Name="AutoStartDescription"
                            Style="{StaticResource CardDescriptionStyle}"
                            Text="登录后静默驻留托盘，不弹出本窗口" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="2" IsOn="False" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7EF;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="以管理员身份运行" />
                        <TextBlock
                            x:Name="RunAsAdminDescription"
                            Style="{StaticResource CardDescriptionStyle}"
                            Text="开启后可拖动、切换任务管理器等管理员窗口" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RunAsAdminToggle" Grid.Column="2" IsOn="False" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE945;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="启动时自动启用拦截" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="应用启动后自动完成注入，无需每次手动打开开关" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoInstallToggle" Grid.Column="2" IsOn="False" Style="{StaticResource CompactToggleStyle}" />
                </Grid>
            </Border>

            <!-- 维护 -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="维护" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE74E;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="PDB 符号缓存" />
                        <TextBlock
                            x:Name="PdbCacheDescription"
                            Style="{StaticResource CardDescriptionStyle}"
                            Text="正在统计缓存占用..." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenCacheFolderButton" Margin="0,0,8,0" Content="打开目录" FontSize="12" />
                        <Button x:Name="ClearCacheButton" Content="清除" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 关于 -->
            <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="关于" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7EE;" Style="{StaticResource CardGlyphStyle}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Touch-Rev" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="关闭本窗口后应用仍在后台运行，可从托盘图标重新打开" />
                    </StackPanel>
                    <Button x:Name="ExitButton" Grid.Column="2" Content="退出应用" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Grid>
